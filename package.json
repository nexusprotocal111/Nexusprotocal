{
  "name": "mlm-roi-backend",
  "version": "1.0.0",
  "description": "Production Node.js / TypeScript MLM Level Recalculation & Eligibility Engine",
  "main": "dist/index.js",
  "scripts": {
    "start": "node server.js",
    "serve": "node server.js",
    "backend:start": "ts-node src/main.ts",
    "cron:run": "ts-node src/main.ts --run-now",
    "test:simulation": "ts-node src/test/simulation-runner.ts",
    "test:web3": "ts-node src/test/web3-deposit-simulation.ts",
    "test:withdrawal": "ts-node src/test/withdrawal-simulation.ts",
    "test:admin": "ts-node src/test/admin-dashboard-simulation.ts",
    "test": "npm run test:simulation && npm run test:web3 && npm run test:withdrawal && npm run test:admin"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@types/ioredis": "^4.28.10",
    "bullmq": "^6.3.4",
    "dotenv": "^16.4.5",
    "ioredis": "^6.0.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
